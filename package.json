{
  "name": "cs2-highlights",
  "version": "0.1.0",
  "private": true,
  "description": "Turn a FACEIT match recording + .dem into a highlight reel",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "cli": "tsx server/cli.ts",
    "seed": "tsx scripts/seed-synthetic.ts",
    "refit": "tsx scripts/refit-sync.ts",
    "test": "vitest run --root .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@laihoe/demoparser2": "^0.42.0",
    "@napi-rs/canvas": "^0.1.65",
    "@ricky0123/vad-node": "^0.0.3",
    "fastify": "^5.12.7",
    "fzstd": "^0.1.1",
    "snappyjs": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
